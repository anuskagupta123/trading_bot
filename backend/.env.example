# Example environment variables for local development
# Copy to .env and fill secrets before running.

# PostgreSQL connection URL
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trading

# Admin token for admin endpoints
ADMIN_TOKEN=changeme_admin_token

# Webhook secret for TradingView
WEBHOOK_SECRET=changeme_webhook_secret

# Secret key for app
SECRET_KEY=changeme_secret_key

ENVIRONMENT=development
# Database
DATABASE_URL=sqlite:///./trading.db
# For production, use PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost/trading_db

# API Keys - DO NOT commit .env file!
ZERODHA_API_KEY=your_zerodha_api_key_here
ZERODHA_API_SECRET=your_zerodha_api_secret_here

# Security
SECRET_KEY=your-secret-key-min-32-chars-for-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Environment
ENVIRONMENT=development
# ENVIRONMENT=production

# CORS
FRONTEND_URL=http://localhost:3000
